# Environment
PORT=3000
NODE_ENV=development
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Payload CMS Secret Key
PAYLOAD_SECRET=your_payload_secret_key_here

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/insta_shorts?retryWrites=true&w=majority

# Cloudflare Stream API Credentials
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_STREAM_API_TOKEN=your_cloudflare_stream_api_token
CLOUDFLARE_WEBHOOK_SECRET=your_cloudflare_webhook_secret
CLOUDFLARE_STREAM_DOMAIN=customer-xxxx.cloudflarestream.com
